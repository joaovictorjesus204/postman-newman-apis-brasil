  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Limite de tempo padrão (5 s) definido a cada requisição. A pasta da Câmara",
          "// muda para 15 s no próprio pre-request, que roda depois deste.",
          "pm.variables.set(\"limiteTempoMs\", 5000);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Nova tentativa automática: se a API responder erro de servidor (5xx), a mesma",
          "// requisição roda de novo, até 2 vezes, com 3 segundos de pausa. A tentativa com",
          "// erro não conta como falha; se o erro continuar na terceira, o teste reprova.",
          "const tentativa = Number(pm.collectionVariables.get(\"tentativa\") || 0);",
          "if (pm.response.code >= 500 && tentativa < 2) {",
          "    console.warn(`${pm.info.requestName}: ${pm.response.code} ${pm.response.status}. Nova tentativa (${tentativa + 1} de 2).`);",
          "    pm.collectionVariables.set(\"tentativa\", tentativa + 1);",
          "    pm.collectionVariables.set(\"repetindo\", \"sim\");",
          "    pm.execution.setNextRequest(pm.info.requestName);",
          "    setTimeout(() => {}, 3000);",
          "    return;",
          "}",
          "pm.collectionVariables.set(\"tentativa\", 0);",
          "pm.collectionVariables.set(\"repetindo\", \"nao\");",
          "",
          "// Critério de desempenho comum a todas as requisições da coleção (5 s, ou 15 s na Câmara).",
          "const limite = Number(pm.variables.get(\"limiteTempoMs\") || 5000);",
          "pm.test(`Responde em até ${limite / 1000} segundos`, () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(limite);",
          "});"
        ]
      }
    }
